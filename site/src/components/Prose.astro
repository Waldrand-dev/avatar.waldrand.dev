---
/**
 * A paragraph of translated copy. The dictionary strings carry `<code>` and
 * entities, so they are set as HTML - they are literals in `src/i18n`, never
 * anything a visitor sent.
 */
interface Props {
  html: string;
  class?: string;
}

const { html, class: className } = Astro.props;
---

<p class:list={["prose mt-0 max-w-[68ch] text-[14.5px] text-body", className]} set:html={html} />
