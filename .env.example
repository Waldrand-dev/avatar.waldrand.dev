# Every value below is a default; an unconfigured container behaves like
# avatar.waldrand.dev does.

# Where to listen.
HOST=0.0.0.0
PORT=8080

# The origin printed in the docs examples and in the `docs` field of an error.
PUBLIC_ORIGIN=https://avatar.waldrand.dev

# Per-IP allowance. 0 turns rate limiting off entirely, for a container that
# already sits behind a gateway that does it.
RATE_LIMIT_PER_MINUTE=60
# Bucket depth - how many requests may be spent at once before the per-minute
# refill applies. 0 means four minutes' worth (240 at the default rate), so a
# page of a couple of hundred avatars loads in one go.
RATE_LIMIT_BURST=0

# Memory for rendered avatars, in MiB. A cache hit - like a 304 - is not
# charged against the rate limit. 0 disables the cache.
RENDER_CACHE_MB=32

# `max-age` on a rendered avatar. Thirty days; they never change.
CACHE_SECONDS=2592000

# How many proxies in front of this container may be believed when they write
# `X-Forwarded-For`. 0 uses the socket address and ignores the header - the
# right answer unless something really is in front.
TRUST_PROXY_HOPS=0

# The private request counters at /stats and /stats.json. Unset - the default -
# means the route does not exist at all. Set it and it is the only thing
# guarding the page, so make it long and random:
#   openssl rand -hex 32
# Minimum 24 characters, or the container refuses to start.
# STATS_TOKEN=

# Which zone the stats page calls "today". UTC unless set.
# STATS_TIMEZONE=Europe/Berlin

# libvips worker threads per request. Two is enough for tiles this small.
SHARP_CONCURRENCY=2
